{
  "name": "orca-rts",
  "version": "1.0.0",
  "description": "Multiplayer RTS game built with Orca Engine featuring map selection and lobby system",
  "main": "server/GameServer.js",
  "scripts": {
    "start": "node server/GameServer.js",
    "dev": "nodemon server/GameServer.js",
    "build": "tsc && vite build",
    "dev:client": "vite",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx",
    "test": "jest"
  },
  "keywords": [
    "rts",
    "game",
    "multiplayer",
    "orca-engine",
    "websocket",
    "react"
  ],
  "author": "Orca RTS Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.6.1",
    "socket.io-client": "^4.6.1",
    "cors": "^2.8.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "eslint": "^8.40.0",
    "eslint-plugin-react": "^7.32.2",
    "nodemon": "^2.0.22",
    "typescript": "^5.0.0",
    "vite": "^4.3.0",
    "@vitejs/plugin-react": "^4.0.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
