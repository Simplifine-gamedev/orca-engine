		at_mention_vbox->add_child(at_mention_tree);
		
		add_child(at_mention_popup);



		// --- Scene Tree Popup ---
		scene_tree_popup = memnew(PopupPanel);
		scene_tree_popup->set_name("scene_tree_popup");
		scene_tree_popup->set_size(Size2i(400, 500));
		
