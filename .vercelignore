# Orca Engine Web Deployment Configuration
# Only allow web-deployment directory and config files

# Ignore everything by default
*

# Allow essential config files
!vercel.json
!package.json

# Allow web-deployment directory and all its contents
!web-deployment/
!web-deployment/**

# Legacy: Allow bin/web_export as backup
!bin/
bin/*
!bin/web_export/
!bin/web_export/**

